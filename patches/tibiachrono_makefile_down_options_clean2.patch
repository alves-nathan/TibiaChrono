diff --git a/Makefile b/Makefile
index 9ec9833..65b5caf 100644
--- a/Makefile
+++ b/Makefile
@@ -15,11 +15,13 @@ JWT_SECRET ?= please-change-me-to-a-very-long-random-secret
 help:
 	@echo "Usage:"
 	@echo "  make up            - build & start prod-like compose (detached)"
