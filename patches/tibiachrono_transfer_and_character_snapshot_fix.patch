+    private Integer parseNullableInt(String s){
+        try {
+            String digits = s.replaceAll("[^0-9]", "");
+            return digits.isBlank() ? null : Integer.parseInt(digits);
+        } catch(Exception e){
+            return null;
+        }
+    }
+
+    private String readCellValue(Element cell) {
+        String text = cell.text().trim();
+        if (!text.isBlank()) {
+            return text;
+        }
+
+        Element image = cell.selectFirst("img[title], img[alt]");
+        if (image != null) {
+            String title = image.attr("title").trim();
+            if (!title.isBlank()) {
+                return title;
+            }
+
+            String alt = image.attr("alt").trim();
+            if (!alt.isBlank()) {
+                return alt;
+            }
+        }
+
+        return null;
+    }
+
+    private String blankToNull(String value) {
+        return value == null || value.isBlank() ? null : value.trim();
+    }
+}
